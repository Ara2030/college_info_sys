# ============================================================
# ШАБЛОН параметров окружения ИС колледжа
# Скопируйте в .env и заполните реальными значениями.
# Файл .env НЕ должен попадать в систему контроля версий!
# ============================================================

# Режим отладки: для продакшена обязательно False
DJANGO_DEBUG=False
# Секретный ключ (сгенерировать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-secret-key
# Разрешённые хосты (через запятую)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,example.ru

# База данных: отдельная роль приложения с минимальными правами (не суперпользователь!)
DB_NAME=college_sys
DB_USER=college_app
DB_PASSWORD=change-me-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432

# Безопасность
# Для продакшена с HTTPS: True (перенаправление на HTTPS)
SECURE_SSL_REDIRECT=False
# Доверенные источники для CSRF (при работе через домен)
CSRF_TRUSTED_ORIGINS=https://example.ru
# Маскировать ПДн (СНИЛС, паспорт) в интерфейсе
MASK_SENSITIVE_DATA=True
