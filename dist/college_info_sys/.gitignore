# Файлы, не подлежащие добавлению в систему контроля версий
# ------------------------------------------------------------

# Секреты и параметры окружения
.env
*.env
!.env.example

# Виртуальное окружение
.venv/
venv/

# Кэш Python
__pycache__/
*.py[cod]
*.egg-info/

# Локальные данные
logs/
backups/
media/
staticfiles/

# База данных (дампы)
*.sql.bak

# IDE / редакторы
.idea/
.vscode/
*.swp
